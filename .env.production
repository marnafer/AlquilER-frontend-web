# Produccion: frontend en alquilerr.alwaysdata.net, API en alquiler.alwaysdata.net.
# Son dominios distintos, asi que va solo el origen: api.js agrega /api por su cuenta.
# El backend autoriza este dominio mediante CORS_ALLOWED_ORIGINS en su .env.
# Si se pondria /api aqui, las rutas quedarian duplicadas (/api/api/...).
VITE_API_URL=https://alquiler.alwaysdata.net
VITE_APP_NAME=Sistema de Alquiler